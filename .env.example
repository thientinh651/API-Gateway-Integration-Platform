# Gateway (Rust) — dev local hoặc copy sang /etc/avaso-gateway/env (systemd)
#
# Production systemd: xem deploy/systemd/README.md
#
# PostgreSQL — bắt buộc (docker compose: user/pass/db = avaso/avaso/avaso_gateway)
DATABASE_URL=postgres://avaso:avaso@127.0.0.1:5432/avaso_gateway
# Session admin (Redis) — bắt buộc; tách khỏi RAM gateway
REDIS_URL=redis://127.0.0.1:6379
# Connection pool PG — giảm trên VPS 2GB (mặc định 5)
PG_POOL_MAX=5
SESSION_DB_RECHECK_SECS=60
# Global X-API-Key admin — tắt mặc định (multi-user). Bật chỉ cho curl dev: ALLOW_ADMIN_API_KEY=1
ALLOW_ADMIN_API_KEY=false
PORT=3000
# Bootstrap một lần vào dashboard_users (Argon2id). Sau đó đổi env không đổi pass DB.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-on-first-login
ADMIN_X_API_KEY=change-me-admin-api-key
CLIENT_KEY_MASTER_KEY=change-me-32-char-minimum-secret!!
INTEGRATION_MASTER_KEY=change-me-integration-master-key!!

# Bind: 127.0.0.1 (production+Nginx) hoặc 0.0.0.0 (Docker)
# BIND_HOST=127.0.0.1

# Salesforce Connected App (OAuth admin — không đưa vào frontend)
# SF_CLIENT_ID=
# SF_CLIENT_SECRET=
# SF_REDIRECT_URI=https://thientinh.io.vn/api/integrations/salesforce/callback
# SF_LOGIN_URL=https://test.salesforce.com
# Sau OAuth redirect về UI:
# INTEGRATIONS_UI_URL=https://thientinh.io.vn/integrations

# Zoho Projects (Server-based Application — api-console.zoho.com)
# ZOHO_CLIENT_ID=
# ZOHO_CLIENT_SECRET=
# ZOHO_REDIRECT_URI=http://127.0.0.1:3000/api/integrations/zoho/callback
# ZOHO_ACCOUNTS_URL=https://accounts.zoho.com
# ZOHO_SCOPES=ZohoProjects.projects.ALL

# UI production (HTTPS): origin đúng scheme+host (không dấu / cuối).
CORS_ALLOWED_ORIGINS=https://thientinh.io.vn,https://www.thientinh.io.vn

# Cookie admin: false cho local HTTP; true trên HTTPS production
COOKIE_SECURE=false

# Email admin bootstrap (lần đầu) + quên mật khẩu
# ADMIN_EMAIL=admin@your-domain.com
#
# Đăng ký công khai — chỉ tạo Viewer (workspace riêng)
# ALLOW_VIEWER_REGISTRATION=1
#
# Gửi OTP: cấu hình SMTP trên SERVER (Gmail app password, SendGrid, Mailtrap…)
# Dev không SMTP: PASSWORD_RESET_DEV_LOG=1 → OTP in journalctl -u avaso-gateway -f
# PASSWORD_RESET_DEV_LOG=1
# SMTP (file riêng trên VPS — khuyến nghị):
#   sudo ./scripts/setup-smtp-gmail.sh '<gmail-app-password>'
# Hoặc /etc/avaso-gateway/smtp.env (chmod 600), xem deploy/systemd/smtp.env.example
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your@gmail.com
# SMTP_PASS=app-password
# SMTP_FROM=your@gmail.com
