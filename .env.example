# Docker Compose: không cần copy file này — compose tự đọc.
# Dashboard Docker: http://127.0.0.1:13000  (login = ADMIN_* bên dưới)
# Host ports: gateway 13000, postgres 15432, redis 16379
#
# PostgreSQL — Docker Compose ghi đè host thành `postgres`
DATABASE_URL=postgres://avaso:avaso@127.0.0.1:5432/avaso_gateway
# Redis — session admin, rate limit, JWT revoke. Docker: host `redis`
REDIS_URL=redis://127.0.0.1:6379
# Số connection tối đa tới Postgres
PG_POOL_MAX=5
# Mỗi N giây session Redis kiểm tra lại user trên DB
SESSION_DB_RECHECK_SECS=60
# true = cho phép gọi API admin bằng header X-API-Key (curl/dev). Demo để false
ALLOW_ADMIN_API_KEY=false
# Port HTTP trong container (host map 13000 → 3000 trong docker-compose.yml)
PORT=3000
# Tài khoản admin để login vào Dashboard
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin
# Key admin khi bật ALLOW_ADMIN_API_KEY
ADMIN_X_API_KEY=chuoiApiKeyAdmin
# Khóa AES mã hóa OAuth client secret trong DB (đổi → secret cũ hỏng)
CLIENT_KEY_MASTER_KEY=chuoiMaHoaOAuth
# Ký / verify JWT data plane (/oauth/token, /v1/api/*)
JWT_SECRET=chuKyVerifyingJWT
# TTL JWT giây
JWT_EXPIRES_SECS=3600
# Claim iss trong JWT
JWT_ISSUER=avaso-gateway
# Khóa AES token Salesforce/Zoho; thiếu thì dùng CLIENT_KEY_MASTER_KEY
INTEGRATION_MASTER_KEY=chuoiMaHoaTokenSalesforceZoho
# Domain CORS
CORS_ALLOWED_ORIGINS=https://thientinh.io.vn,https://www.thientinh.io.vn
# true = cookie chỉ HTTPS. Docker local HTTP phải false
COOKIE_SECURE=false
