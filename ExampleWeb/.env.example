# Dev / vite preview: proxy /api → gateway (đổi port nếu gateway dùng PORT khác).
# Cổng phải là process **avaso-gateway** repo này (cargo run); process khác trên :3000 → login 404.
VITE_GATEWAY_ORIGIN=http://127.0.0.1:3000
# Tùy chọn production: URL gốc API (https://...), không dấu / cuối. Chỉ khi trang web và API khác origin/path;
# cookie đăng nhập cần CORS + (thường) cùng site / subdomain + Domain cookie — ưu tiên sửa Nginx proxy /api/ cùng host.
# VITE_API_BASE_URL=https://api.thientinh.io.vn
# Plaintext khớp hash admin trong SQLite (lần đầu: ADMIN_X_API_KEY khi cargo run, default dev key12345).
VITE_ADMIN_X_API_KEY=key12345
