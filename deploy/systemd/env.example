# Copy → sudo mkdir -p /etc/avaso-gateway && sudo cp deploy/systemd/env.example /etc/avaso-gateway/env
# Chỉnh mật khẩu và origin trước khi bật service.

DATABASE_URL=postgres://avaso:avaso@127.0.0.1:5432/avaso_gateway
REDIS_URL=redis://127.0.0.1:6379
PG_POOL_MAX=5
PORT=3000

ADMIN_X_API_KEY=HocSinhTest2026
CLIENT_KEY_MASTER_KEY=thay-bang-chuoi-ngau-nhien-dai-32-ky-tu-tro-len
INTEGRATION_MASTER_KEY=thay-bang-chuoi-ngau-nhien-khac-client-key

ADMIN_USERNAME=admin
ADMIN_PASSWORD=doi-mat-khau-manh-o-day

COOKIE_SECURE=true
CORS_ALLOWED_ORIGINS=https://thientinh.io.vn,https://www.thientinh.io.vn

# On-prem thực tế (chạy: sudo ./scripts/setup-practical-onprem.sh sf-dev)
# INTEGRATION_SYNC_INTERVAL_MINS=15
# (Chỉ dùng lần đầu nếu chưa có gateway_settings; sau đó chỉnh trên UI Tích hợp)
# INTEGRATION_MIN_DEAL_AMOUNT=250000
# Không set ALLOW_VIEWER_REGISTRATION — đăng ký Viewer tắt mặc định

# SF/Zoho Client ID/Secret: Dashboard → Integrations (không env)

# Chiều Zoho hoàn thành → SF (đồng bộ định kỳ trong Sync Now / worker)
# INTEGRATION_SF_DELIVERY_FIELD=Project_Completed__c
# INTEGRATION_SF_INVOICE_ENABLED=1
# INTEGRATION_SF_INVOICE_OBJECT=Invoice__c
