# Copy → sudo mkdir -p /etc/avaso-gateway && sudo cp deploy/systemd/env.example /etc/avaso-gateway/env
# Chỉnh mật khẩu và origin trước khi bật service.

DATABASE_URL=sqlite:data/gateway.db
PORT=3000

# Lần đầu tạo DB (hash admin). Sau đó đổi env không tự đổi key trong DB.
ADMIN_X_API_KEY=HocSinhTest2026

# Mã hóa SECRET_KEY client (HMAC) trong SQLite — đổi = không decrypt key cũ.
CLIENT_KEY_MASTER_KEY=thay-bang-chuoi-ngau-nhien-dai-32-ky-tu-tro-len

# Chỉ dùng lần đầu khi bảng admin_users trống (hash Argon2id rồi lưu DB).
# Đổi env sau đó KHÔNG đổi mật khẩu đã lưu — cập nhật qua DB hoặc API users (ngày 3).
ADMIN_USERNAME=admin
ADMIN_PASSWORD=doi-mat-khau-manh-o-day

COOKIE_SECURE=true
CORS_ALLOWED_ORIGINS=https://thientinh.io.vn,https://www.thientinh.io.vn

# Tuỳ chọn: prefix data-plane (mặc định /v1/api)
# DATA_PLANE_PREFIX=/v1/api

# OAuth connectors (token AES at rest)
INTEGRATION_MASTER_KEY=thay-bang-chuoi-ngau-nhien-khac-client-key
# SF_CLIENT_ID=
# SF_CLIENT_SECRET=
# SF_REDIRECT_URI=https://thientinh.io.vn/api/integrations/salesforce/callback
# SF_LOGIN_URL=https://test.salesforce.com
# INTEGRATIONS_UI_URL=https://thientinh.io.vn/integrations
