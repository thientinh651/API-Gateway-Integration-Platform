# Copy → sudo cp deploy/systemd/smtp.env.example /etc/avaso-gateway/smtp.env
# chmod 600 /etc/avaso-gateway/smtp.env
# Hoặc: sudo ./scripts/setup-smtp-gmail.sh '<gmail-app-password>'

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@gmail.com
SMTP_PASS=your-gmail-app-password
SMTP_FROM=your@gmail.com
