        </mxCell>

        <mxCell id="legend" parent="1" value="&lt;b&gt;Mô hình triển khai:&lt;/b&gt; mỗi tổ chức (Công ty A, Công ty B) cài &lt;b&gt;phiên bản Gateway riêng&lt;/b&gt; + PostgreSQL/Redis riêng — &lt;b&gt;không&lt;/b&gt; dùng chung CSDL.&lt;br&gt;&lt;b&gt;Người vận hành Gateway&lt;/b&gt; = nhân sự nội bộ tổ chức sở hữu instance (đăng nhập console, cấu hình route/key, tích hợp SF/Zoho, giám sát).&lt;br&gt;Phân quyền &lt;b&gt;Admin / Operator / Viewer&lt;/b&gt; là RBAC &lt;b&gt;nội bộ&lt;/b&gt; một tổ chức — mô tả ở sơ đồ use case &lt;b&gt;chi tiết&lt;/b&gt; hoặc mục 2.3, &lt;b&gt;không&lt;/b&gt; vẽ kế thừa actor ở mức tổng quát.&lt;br&gt;Data Plane (UC3) do &lt;b&gt;Client hệ thống&lt;/b&gt; gọi qua API; người vận hành chỉ cấu hình/giám sát, không thay thế client." style="text;html=1;strokeColor=#CCCCCC;fillColor=#FAFAFA;align=left;spacingLeft=8;fontSize=10;rounded=1;" vertex="1">
          <mxGeometry x="80" y="580" width="920" height="88" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
