        <mxCell id="caption" parent="1" value="Hình 2.5. Sơ đồ use case tổng quát hệ thống Avaso API Gateway" style="text;html=1;strokeColor=none;fillColor=none;align=center;fontStyle=2;fontSize=11;" vertex="1">
