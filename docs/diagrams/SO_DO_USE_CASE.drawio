        <mxCell id="uc3" value="Xử lý yêu cầu&#xa;(do Gateway thực hiện)" style="ellipse;whiteSpace=wrap;html=1;strokeColor=#000000;fillColor=#fff2cc;fontStyle=1;fontSize=12;" vertex="1" parent="sys">
