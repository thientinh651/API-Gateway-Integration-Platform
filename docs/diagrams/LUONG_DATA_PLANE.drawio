        <mxCell id="c4" value="Upstream" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveResize=0;outlineConnect=0;fillColor=#f5f5f5" vertex="1" parent="1">
          <mxGeometry x="680" y="70" width="100" height="520" as="geometry"/>
        </mxCell>

        <mxCell id="m1" value="GET /v1/api/... + Authorization: Bearer JWT" style="html=1;verticalAlign=bottom;endArrow=block;rounded=0" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
