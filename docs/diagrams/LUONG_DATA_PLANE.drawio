        <mxCell id="c3" value="PostgreSQL" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveResize=0;outlineConnect=0;fillColor=#dae8fc" vertex="1" parent="1">
          <mxGeometry x="480" y="70" width="100" height="520" as="geometry"/>
