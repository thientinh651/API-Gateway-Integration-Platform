<mxfile host="app.diagrams.net" agent="avaso-gateway" version="22.1.0" type="device">
  <diagram id="luong-data-plane" name="Luong Data Plane (sequence)">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="700" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <mxCell id="t" value="Luồng 1 request Data Plane (OAuth2 JWT) — khớp identity.rs + main.rs + proxy_ext.rs" style="text;html=1;strokeColor=none;fillColor=none;align=center;fontSize=14;fontStyle=1" vertex="1" parent="1">
