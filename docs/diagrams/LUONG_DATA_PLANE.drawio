        <mxCell id="c2" value="Gateway" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveResize=0;outlineConnect=0;fillColor=#d5e8d4" vertex="1" parent="1">
          <mxGeometry x="280" y="70" width="100" height="520" as="geometry"/>
